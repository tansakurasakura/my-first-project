{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-first-project",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM",
        "class_name": "ClassroomHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClassroomHandler"]
    }
  ]
}
